{
  "name": "@t8ngs/expect-type",
  "description": "Write assertions for TypeScript types",
  "version": "1.2.0",
  "engines": {
    "node": ">=18.16.0"
  },
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js"
  },
  "scripts": {
    "pretest": "npm run lint",
    "test": "echo \"No tests\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "precompile": "npm run lint",
    "clean": "del-cli build",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration",
    "build": "npm run compile",
    "version": "npm run build",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "commit": "cz"
  },
  "devDependencies": {
    "@arapucajs/eslint-config": "^1.1.2",
    "@arapucajs/prettier": "^1.1.1",
    "@arapucajs/tsconfig": "^1.0.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@poppinss/ts-exec": "^1.4.1",
    "@release-it/conventional-changelog": "^10.0.3",
    "@t8ngs/runner": "^1.0.1",
    "@types/node": "^25.0.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "tsdown": "^0.17.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "expect-type": "^1.3.0"
  },
  "peerDependencies": {
    "@t8ngs/runner": "^1.0.1"
  },
  "homepage": "https://github.com/t8ngs/expect-type#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t8ngs/expect-type.git"
  },
  "bugs": {
    "url": "https://github.com/t8ngs/expect-type/issues"
  },
  "keywords": [],
  "author": "Jefte Costa <jefteamorim@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "tsdown": {
    "entry": [
      "index.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  },
  "prettier": "@arapucajs/prettier",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  }
}
